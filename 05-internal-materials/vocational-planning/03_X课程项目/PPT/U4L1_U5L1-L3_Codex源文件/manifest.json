      {
        "page": 5,
        "title": "用同一帧检测和画框",
        "role": "操作代码",
        "layout": "code",
        "code": [
          {
            "cell": 9,
            "line": 3,
            "text": "img = robot.get_image(img_type=\"rgb\")"
          },
          {
            "cell": 9,
            "line": 6,
            "text": "img_array = img.to_numpy()"
          },
          {
            "cell": 9,
            "line": 7,
            "text": "results = detector.detect(img_array)"
          },
          {
            "cell": 9,
            "line": 13,
            "text": "plt.imshow(img_array[:, :, ::-1])   # [:, :, ::-1] 把采集到的 bgr 通道转为 rgb 排列"
          },
          {
            "cell": 9,
            "line": 14,
            "text": "plt.show()"
          }
