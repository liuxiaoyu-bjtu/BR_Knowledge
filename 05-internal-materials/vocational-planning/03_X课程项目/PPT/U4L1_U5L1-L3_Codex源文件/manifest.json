        "code": [
          {
            "cell": 5,
            "line": 1,
            "text": "from boosteros.robots.booster import BoosterRobot"
          },
          {
            "cell": 5,
            "line": 2,
            "text": "from boosteros.brain import Detection"
          },
          {
            "cell": 5,
            "line": 4,
            "text": "robot = BoosterRobot()"
          },
          {
            "cell": 5,
            "line": 5,
            "text": "detector = Detection(model=\"default\")"
          }
