      {
        "page": 9,
        "title": "Kp先从小值试起",
        "role": "预测与计算",
        "layout": "code",
        "code": [
          {
            "cell": 21,
            "line": 1,
            "text": "Kp = 0.001                      # 比例系数（弧度 / 像素）：先从一个小值试"
          },
          {
            "cell": 21,
            "line": 3,
            "text": "head_step = -Kp * error0"
          }
        ]
      },
      {
        "page": 10,
        "title": "从回读的头角开始累加",
        "role": "操作代码",
        "layout": "code",
        "code": [
          {
            "cell": 25,
            "line": 3,
            "text": "head_yaw = robot.get_joint_states()[\"aahead_yaw_joint\"].position   # 头部水平角度（弧度）"
          },
          {
            "cell": 25,
            "line": 10,
            "text": "for i in range(40):"
          },
          {
            "cell": 25,
            "line": 19,
            "text": "    error = bottle_r[0].bbox.center_x - img.width / 2"
          },
          {
            "cell": 25,
            "line": 25,
            "text": "    head_yaw = head_yaw - Kp * error"
          },
          {
            "cell": 25,
            "line": 26,
            "text": "    robot.set_head_angle(0, head_yaw)"
          }
        ]
