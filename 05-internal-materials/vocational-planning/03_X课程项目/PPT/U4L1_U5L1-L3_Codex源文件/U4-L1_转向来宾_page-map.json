      "code": []
    },
    {
      "page": 5,
      "title": "用同一帧检测和画框",
      "role": "操作代码",
      "layout": "code",
      "code": [
        {
          "cell": 9,
          "line": 3,
          "text": "img = robot.get_image(img_type=\"rgb\")"
        },
        {
          "cell": 9,
          "line": 6,
          "text": "img_array = img.to_numpy()"
        },
        {
          "cell": 9,
          "line": 7,
          "text": "results = detector.detect(img_array)"
        },
        {
          "cell": 9,
          "line": 13,
          "text": "plt.imshow(img_array[:, :, ::-1])   # [:, :, ::-1] 把采集到的 bgr 通道转为 rgb 排列"
        },
        {
          "cell": 9,
          "line": 14,
          "text": "plt.show()"
        }
      ]
    },
    {
      "page": 6,
      "title": "从瓶子列表取出一个目标",
      "role": "操作代码与手算",
      "layout": "code",
      "code": [
        {
          "cell": 13,
          "line": 2,
          "text": "bottle_r = [r for r in results if r.class_name == \"bottle\"]"
        },
        {
          "cell": 15,
          "line": 1,
          "text": "error0 = bottle_r[0].bbox.center_x - img.width / 2"
        }
      ]
    },
    {
      "page": 7,
      "title": "图像坐标与头部转角方向",
      "role": "图示",
