    {
      "page": 15,
      "title": "清零后朝已测头角转身",
      "role": "代码流程",
      "layout": "code",
      "code": [
        {
          "cell": 35,
          "line": 1,
          "text": "robot.reset_odom()   "
        },
        {
          "cell": 35,
          "line": 2,
          "text": "robot.set_head_angle(0, 0)      # 头回正"
        },
        {
          "cell": 35,
          "line": 4,
          "text": "yaw_now = robot.get_odom().pose_2d[2]     # 读取当前里程计的朝向角"
        },
        {
          "cell": 35,
          "line": 7,
          "text": "    turn_rad = robot.get_odom().pose_2d[2] - yaw_now"
        },
        {
          "cell": 35,
          "line": 8,
          "text": "    if abs(turn_rad) < abs(head_yaw):"
        },
        {
          "cell": 35,
          "line": 9,
          "text": "        robot.set_velocity(0, 0, 0.5*head_yaw)"
        },
        {
          "cell": 35,
          "line": 10,
          "text": "    else:"
        },
        {
          "cell": 35,
          "line": 11,
          "text": "        robot.set_velocity(0, 0, 0)"
        },
        {
          "cell": 35,
          "line": 12,
          "text": "        break"
        }
      ]
    },
