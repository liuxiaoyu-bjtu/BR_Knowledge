    {
      "page": 20,
      "title": "前一任务成功后再进入下一步",
      "role": "操作代码",
      "layout": "code",
      "code": [
        {
          "cell": 32,
          "line": 6,
          "text": "if \"task\" in globals() and not task.done():"
        },
        {
          "cell": 32,
          "line": 11,
          "text": "    handle = speech.synthesize(welcome_msg)"
        },
        {
          "cell": 32,
          "line": 12,
          "text": "    audio = handle.result()"
        },
        {
          "cell": 32,
          "line": 15,
          "text": "    playback = robot.play_sound(audio)"
        },
        {
          "cell": 32,
          "line": 16,
          "text": "    playback_status = playback.wait()"
        },
        {
          "cell": 32,
          "line": 17,
          "text": "    if playback_status != \"SUCCEEDED\":"
        },
        {
          "cell": 32,
          "line": 23,
          "text": "        task = speech.recognize_stream(on_result=on_text)"
        }
      ]
    },
    {
      "page": 21,
      "title": "观察机器人听到了什么",
      "role": "观察与收尾",
      "layout": "code",
      "code": [
        {
          "cell": 32,
          "line": 20,
          "text": "        def on_text(text):"
        },
        {
          "cell": 32,
          "line": 21,
          "text": "            print(\"识别到：\", text)"
        },
        {
          "cell": 32,
          "line": 26,
          "text": "            time.sleep(6)  # 观察窗口，不是识别处理耗时"
        },
        {
          "cell": 32,
          "line": 28,
          "text": "            accepted = task.cancel()"
        },
        {
          "cell": 32,
          "line": 30,
          "text": "            task.wait(timeout=5.0)"
        },
        {
          "cell": 32,
          "line": 32,
          "text": "        if not task.done():"
