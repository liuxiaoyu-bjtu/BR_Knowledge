    {
      "page": 20,
      "title": "打印回调来观察转写过程",
      "role": "操作代码",
      "layout": "code",
      "code": [
        {
          "cell": 31,
          "line": 5,
          "text": "def on_text(text):"
        },
        {
          "cell": 31,
          "line": 6,
          "text": "    print(\"识别到：\", text)"
        },
        {
          "cell": 31,
          "line": 12,
          "text": "    task = speech.recognize_stream(on_result=on_text)"
        },
        {
          "cell": 31,
          "line": 15,
          "text": "        time.sleep(6)  # 留出6秒供观察文字回调，不代表识别一句话需要6秒"
        },
        {
          "cell": 31,
          "line": 17,
          "text": "        accepted = task.cancel()"
        },
        {
          "cell": 31,
          "line": 19,
          "text": "        task.wait(timeout=5.0)"
        },
        {
          "cell": 31,
          "line": 21,
          "text": "    if not task.done():"
        }
      ]
    },
    {
      "page": 21,
