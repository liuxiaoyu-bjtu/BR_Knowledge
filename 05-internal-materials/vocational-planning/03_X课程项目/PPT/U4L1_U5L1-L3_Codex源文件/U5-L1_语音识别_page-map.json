        {
          "cell": 25,
          "line": 3,
          "text": "queue_size = 4  # 第一组为4；播放结束后改为64，再运行本格"
        },
        {
          "cell": 25,
          "line": 9,
          "text": "    stream = robot.audio_manager.play_stream(channels=3, queue_size=queue_size, overflow=\"block\")"
        },
        {
          "cell": 25,
          "line": 11,
          "text": "    start_time = time.perf_counter()"
        },
        {
          "cell": 25,
          "line": 13,
          "text": "        for i, chunk in enumerate(chunks):"
        },
        {
          "cell": 25,
          "line": 15,
          "text": "            stream.write(chunk)"
        },
        {
          "cell": 25,
          "line": 20,
          "text": "    finally:"
        },
        {
          "cell": 25,
          "line": 21,
          "text": "        stream.close()  # 结束输入，排队的音频继续播放"
        },
